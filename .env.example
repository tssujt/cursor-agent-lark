# Single-bot quick start via environment variables (used when no bots are defined in config.toml)
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# "feishu" (China) or "lark" (International, default)
LARK_DOMAIN=lark
LARK_LOG_LEVEL=info
# Set to false to auto-create threads for top-level group messages without @mention
# LARK_REQUIRE_MENTION=true

# Multi-bot secrets referenced from config.toml via ${ENV_VAR}
# LARK_BACKEND_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# LARK_FRONTEND_APP_SECRET=yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# Cursor API Key (generate at https://cursor.com/dashboard/api)
CURSOR_API_KEY=key_xxxxxxxxxxxxxxxx
# "cloud" (default) or "local"
CURSOR_RUNTIME=cloud
# Local runtime options (used when CURSOR_RUNTIME=local)
# CURSOR_LOCAL_CWD=/path/to/workspace
# CURSOR_LOCAL_SANDBOX=true
# CURSOR_LOCAL_AUTO_REVIEW=false
CURSOR_API_BASE_URL=https://api.cursor.com
CURSOR_DEFAULT_MODEL=
CURSOR_DEFAULT_MODE=agent
CURSOR_AUTO_CREATE_PR=false
CURSOR_WORK_ON_CURRENT_BRANCH=false
CURSOR_ENABLE_STEER=true
CURSOR_USE_SSE=true
CURSOR_POLL_INTERVAL=10s

# HTTP server listen address (serves /healthz and /mcp)
SERVER_ADDR=:8080

# Optional: Public HTTPS URL of this gateway to enable the built-in `ask_user` MCP server.
# Leave empty to use the zero-webhook Prompt-JSON HITL fallback automatically.
MCP_PUBLIC_URL=
MCP_AUTH_TOKEN=
MCP_SERVER_NAME=lark-hitl

# HITL & Permissions
HITL_ENABLE_PROMPT_FALLBACK=true
HITL_ALLOW_ANY_CHAT_MEMBER_ANSWER=false
ALLOWED_USERS=
DEFAULT_REPO=
ALLOW_UNLISTED_REPOS=true
ALLOW_NO_REPO=true
LOG_LEVEL=info
