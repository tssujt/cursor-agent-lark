{
  "name": "cursor-agent-lark",
  "version": "0.1.0",
  "description": "Multi-bot Lark gateway for Cursor Agents (cloud & local) with thread sessions, HITL questions, and multi-MCP support",
  "license": "MIT",
  "type": "module",
  "main": "./src/lib.ts",
  "exports": {
    ".": "./src/lib.ts",
    "./cli": "./src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun test"
  },
  "dependencies": {
    "@cursor/sdk": "latest",
    "@larksuiteoapi/node-sdk": "latest",
    "@modelcontextprotocol/sdk": "latest",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.5"
}
